# HiDOS Cell Cloud configuration.
#
# docker compose: copy to .env next to docker-compose.yml.
# Manual development: copy to hidos-django/hidos/.env (read by the Django
# settings), or export the variables in your shell.
# Never commit the real .env.

# --- required in production -----------------------------------------------------
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Comma separated host names the site is served under
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
# Origins allowed to POST forms (admin, login), with scheme
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# --- database / broker -------------------------------------------------------------
# docker compose builds these from POSTGRES_PASSWORD and RABBITMQ_PASSWORD
POSTGRES_PASSWORD=django
RABBITMQ_PASSWORD=hidos
# Manual development (defaults shown):
# DATABASE_URL=postgres://django@localhost:5432/django
# CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# CELERY_RESULT_BACKEND=            # optional, task state is kept in the database
# CELERY_TASK_ALWAYS_EAGER=false    # true runs analyses in the web process (no broker)
# CELERY_CONCURRENCY=2              # docker compose worker processes

# --- web ---------------------------------------------------------------------------
# HIDOS_PORT=8080                   # docker compose: published nginx port
# DJANGO_DEBUG=false                # local settings default to true
# DJANGO_SETTINGS_MODULE=hidos.settings.production   # set by the Docker image
# DJANGO_ADMINS=Han Lin:admin@example.com            # receive error emails
# SITE_DOMAIN=hidos.io              # written to django.contrib.sites (#78), used in emails
# SITE_NAME=HiDOS
# TIME_ZONE=Asia/Taipei
# LOGIN_REDIRECT_URL=/
# SESSION_COOKIE_SECURE=true        # production default; compose sets false for http://localhost
# CSRF_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=false         # TLS is usually handled by the reverse proxy
# SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# CORS_ALLOWED_ORIGINS=https://app.example.org       # the single page app's origin(s)
# CORS_ALLOWED_ORIGIN_REGEXES=^https://([\w-]+\.)*hidos\.io$
# API_SESSION_AUTH=false            # true lets a logged in browser session use the API (browsable API)
# NUM_PROXIES=1                     # reverse proxies in front of Django; docker compose: 1 (nginx)
# CACHE_URL=locmemcache://          # docker compose: dbcache://hidos_cache (run createcachetable)

# --- files -------------------------------------------------------------------------
# MEDIA_ROOT=/data/media            # uploaded images and results (Docker default)
# MEDIA_URL=/media/
# STATIC_ROOT=...                   # collectstatic target
# STATIC_URL=/static/
# CHUNKED_UPLOAD_ROOT=/data/chunked_uploads          # unfinished uploads, not public
# CHUNKED_UPLOAD_MAX_BYTES=209715200
# CHUNKED_UPLOAD_EXPIRATION_HOURS=24
# CHUNKED_UPLOAD_MAX_OPEN=20        # unfinished uploads per user
# TASK_UPLOAD_MAX_BYTES=209715200
# DATA_UPLOAD_MAX_MEMORY_SIZE=10485760               # largest chunk / request body
# PROFILE_IMAGE_MAX_BYTES=2097152
# THUMBNAIL_SIZE=256

# --- accounts ----------------------------------------------------------------------
# Outgoing mail, e.g. smtp+tls://user:password@smtp.example.com:587
# (default prints emails to the console)
# EMAIL_URL=consolemail://
# DEFAULT_FROM_EMAIL=HiDOS Cell Cloud <noreply@hidos.io>
# SERVER_EMAIL=
# ACCOUNT_EMAIL_VERIFICATION=mandatory
# Social login (or configure them in the admin under Social applications)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# JWT_ACCESS_DAYS=7
# JWT_REFRESH_DAYS=365

# --- rate limits (DRF throttle rates) ------------------------------------------------
# THROTTLE_ANON=10/h
# THROTTLE_REGISTER=2/h
# THROTTLE_AUTH=60/h
# THROTTLE_TASK_SUBMIT=600/h
# THROTTLE_UPLOAD_CHUNK=6000/h

# --- monitoring ----------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_DIR=                          # also write rotating django.log / celery.log here
# SLACK_WEBHOOK_URL=                # report failed analyses to Slack
# SLACK_CHANNEL=#image-bug
# GOOGLE_ANALYTICS_ID=              # e.g. G-XXXXXXX; off when empty

# --- landing page (hidos-express) -------------------------------------------------------
# CELL_CLOUD_LOGIN_URL=/login
# PORT=3000

# --- legacy ------------------------------------------------------------------------------
# R_SCRIPT=/usr/bin/Rscript         # only for the R versions of the algorithms in */bin/*.R
# FONT=DejaVuSerif-Italic.ttf
