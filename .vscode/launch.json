{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Django",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/hidos-django/hidos/env/Scripts/python",
            "program": "${workspaceFolder}/hidos-django/hidos/manage.py",
            "cwd": "${workspaceFolder}/hidos-django/hidos/",
            "args": [
                "runserver",
                "--noreload"
            ],
            "django": true,
            "env": {
                "DJANGO_SETTINGS_MODULE": "hidos.settings.local"
            }
        },
        {
            "name": "Celery worker",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/hidos-django/hidos/env/Scripts/python",
            "module": "celery",
            "cwd": "${workspaceFolder}/hidos-django/hidos/",
            "args": ["-A", "hidos", "worker", "--loglevel=info", "--pool=solo", "-Q", "cell"],
            "env": {
                "DJANGO_SETTINGS_MODULE": "hidos.settings.local"
            }
        },
        {
            "name": "Tests",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/hidos-django/hidos/env/Scripts/python",
            "module": "pytest",
            "cwd": "${workspaceFolder}/hidos-django/hidos/",
            "args": ["-m", "not analysis"]
        }
    ]
}
